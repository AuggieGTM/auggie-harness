# This file is a backstop, not the publication boundary. Customer data,
# credentials and private planning material must never be placed in this
# working tree in the first place. See docs/adr/0010-public-repository-boundary.md.

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets and local environment
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Local-only working files (e.g. exported PR visuals)
.context/

# Maintainer-local SageOx integration (ADR 0011). Never published: it names
# private teams and links to private session recordings.
.sageox/
.claude/

# Editors and OS
.idea/
.vscode/
.DS_Store
